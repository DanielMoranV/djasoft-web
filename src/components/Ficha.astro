---
/**
 * Ficha comercial sin logotipo ni pila tecnica: en la portada importan el
 * problema, la solucion y la prueba. Las tecnologias siguen visibles en la
 * pagina individual de cada producto y en el perfil tecnico.
 */
import type { Producto } from '../data/productos';
import { s } from '../textos';
import Flecha from './Flecha.astro';

interface Props {
  producto: Producto;
}
const { producto } = Astro.props;
---

<article class="ficha pt-5" style="border-top: 2px solid var(--tinta);">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <p class="etiqueta" style="color: var(--senal-txt);">{producto.es.que}</p>
    {
      producto.nota && (
        <span class="etiqueta" style="color: var(--tinta2);">
          {producto.nota}
        </span>
      )
    }
  </div>

  <h3 class="mt-2" style="font-size: var(--text-ficha); line-height: 1.15;">
    <a href={`/productos/${producto.id}`} class="hover:underline">{producto.nombre}</a>
  </h3>

  {
    producto.cliente && (
      <p class="text-[0.9375rem]" style="color: var(--tinta2);">
        {producto.cliente}
      </p>
    )
  }

  <p class="mt-3 text-[1rem] leading-[1.6]">{producto.es.detalle}</p>

  {
    producto.url && (
      <a
        href={producto.url}
        target="_blank"
        rel="noopener noreferrer"
        class="etiqueta mt-5 inline-flex items-center gap-1.5 underline decoration-[3px] underline-offset-[6px]"
        style="color: var(--tinta); text-decoration-color: var(--senal);"
      >
        {s.abrir} {producto.nombre}
        <Flecha />
      </a>
    )
  }
</article>
