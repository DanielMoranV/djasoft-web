---
import Ficha from './Ficha.astro';
import BandaLogos from './BandaLogos.astro';
import IndiceSistemas from './IndiceSistemas.astro';
import Flecha from './Flecha.astro';
import { propios, paraClientes, productos, sectores } from '../data/productos';
import { s } from '../textos';

const enProduccion = productos.filter((p) => p.url).length;

const resuelvo = [
  { titulo: s.r1Titulo, texto: s.r1Texto },
  { titulo: s.r2Titulo, texto: s.r2Texto },
  { titulo: s.r3Titulo, texto: s.r3Texto },
];

const servicios = [
  { titulo: s.sv1Titulo, texto: s.sv1Texto },
  { titulo: s.sv2Titulo, texto: s.sv2Texto },
  { titulo: s.sv3Titulo, texto: s.sv3Texto },
  { titulo: s.sv4Titulo, texto: s.sv4Texto },
];

const logo = (p: (typeof productos)[number]) => ({
  src: p.iconoSrc,
  alt: p.cliente ?? p.nombre,
});
---

<!-- 1 · Hero. El titular ocupa la pantalla en movil: es uno de los dos unicos
     puntos ruidosos de la pagina, el otro es el indice. -->
<section class="px-6" style="padding-top: var(--paso-seccion); padding-bottom: var(--paso-respiro);">
  <div class="mx-auto max-w-[var(--container-ficha)]">
    <h1 class="max-w-[14ch]" style="font-size: var(--text-rotulo); line-height: 0.95;">
      {s.heroTitulo}
    </h1>

    <p class="prosa mt-10">{s.heroEntrada}</p>

    <p class="prosa mt-6 font-semibold" style="color: var(--senal-txt);">{s.heroPrueba}</p>

    <!-- Las metricas dejan de ser tres bloques de cifra grande —el gesto de
         pitch que el resto del sitio rechaza— y pasan a una linea de datos. -->
    <dl
      class="rotulo mt-12 flex flex-wrap items-baseline gap-x-3 gap-y-2 pt-5 text-[0.9375rem] tabular-nums"
      style="border-top: 1px solid var(--linea); color: var(--tinta2); font-weight: 400;"
    >
      <dt class="sr-only">Sistemas</dt>
      <dd><b style="color: var(--tinta);">{enProduccion}</b> {s.metricaProductos}</dd>
      <span aria-hidden="true">·</span>
      <dt class="sr-only">Sectores</dt>
      <dd><b style="color: var(--tinta);">{sectores}</b> {s.metricaSectores}</dd>
      <span aria-hidden="true">·</span>
      <dt class="sr-only">Registros</dt>
      <dd><b style="color: var(--tinta);">500 000+</b> {s.metricaRegistros}</dd>
    </dl>
  </div>
</section>

<!-- 2 · Que resuelvo. La unica seccion sin rejilla y sin borde: columna de
     prosa a 62ch. Aqui es donde la serif hace su trabajo. -->
<section id="resuelvo" class="scroll-mt-20 px-6" style="padding-bottom: var(--paso-respiro);">
  <div class="mx-auto max-w-[var(--container-prosa)]">
    <p class="etiqueta" style="color: var(--senal-txt);">{s.resuelvoTitulo}</p>
    <p class="prosa mt-4" style="color: var(--tinta2);">{s.resuelvoEntrada}</p>

    <div class="mt-16 flex flex-col gap-16">
      {
        resuelvo.map((r, i) => (
          <div>
            <span class="rotulo block text-[2.5rem] leading-none tabular-nums" style="color: var(--senal-txt);">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 class="mt-3" style="font-size: var(--text-seccion); line-height: 1.02;">
              {r.titulo}
            </h2>
            <p class="prosa mt-5">{r.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 3 · Por que contratarme. Cuatro filas, no tarjetas: tabular a proposito,
     para contrastar con el bloque de prosa que viene justo antes. -->
<section id="servicios" class="scroll-mt-20 px-6" style="padding-bottom: var(--paso-respiro);">
  <div class="mx-auto max-w-[var(--container-ficha)]">
    <p class="etiqueta" style="color: var(--senal-txt);">{s.serviciosTitulo}</p>
    <h2 class="mt-3 max-w-[20ch]" style="font-size: var(--text-seccion); line-height: 1.02;">
      {s.serviciosEntrada}
    </h2>

    <div class="mt-12" style="border-top: 1px solid var(--linea);">
      {
        servicios.map((sv, i) => (
          <div
            class="grid gap-x-8 gap-y-2 py-8 sm:grid-cols-[4rem_1fr]"
            style="border-bottom: 1px solid var(--linea);"
          >
            <span class="rotulo text-[2.5rem] leading-none tabular-nums" style="color: var(--senal-txt);">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 style="font-size: var(--text-ficha); line-height: 1.15;">{sv.titulo}</h3>
              <p class="mt-3 max-w-[var(--container-prosa)]">{sv.texto}</p>
            </div>
          </div>
        ))
      }
    </div>

    <a
      href="#contacto"
      class="etiqueta mt-10 inline-flex items-center gap-2 px-5 py-4"
      style="background: var(--senal); color: var(--color-tinta-claro);"
    >
      {s.serviciosLlamada}
      <Flecha />
    </a>
  </div>
</section>

<!-- 4 · Casos de exito. Los logotipos salen de las fichas y se agrupan arriba. -->
<BandaLogos titulo={s.bandaClientes} logos={paraClientes.map(logo)} />

<section id="clientes" class="scroll-mt-20 px-6" style="padding-block: var(--paso-seccion);">
  <div class="mx-auto max-w-[var(--container-ficha)]">
    <p class="etiqueta" style="color: var(--senal-txt);">{s.clientesTitulo}</p>
    <h2 class="mt-3 max-w-[24ch]" style="font-size: var(--text-seccion); line-height: 1.02;">
      {s.clientesEntrada}
    </h2>

    <div class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-2">
      {paraClientes.map((p) => <Ficha producto={p} />)}
    </div>
  </div>
</section>

<!-- 5 · El indice: el momento que ancla el recuerdo de la pagina. -->
<IndiceSistemas />

<!-- 6 · Proyectos propios, ya en papel y con la descripcion larga. -->
<BandaLogos titulo={s.bandaProductos} logos={propios.map(logo)} />

<section id="productos" class="scroll-mt-20 px-6" style="padding-block: var(--paso-seccion);">
  <div class="mx-auto max-w-[var(--container-ficha)]">
    <p class="etiqueta" style="color: var(--senal-txt);">{s.productosTitulo}</p>
    <p class="prosa mt-4">{s.productosEntrada}</p>

    <div class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-2">
      {propios.map((p) => <Ficha producto={p} />)}
    </div>
  </div>
</section>

<!-- 7 · Contacto. Segunda y ultima banda a sangre, en azul profundo. -->
<section
  id="contacto"
  class="scroll-mt-20 px-6"
  style="background: var(--marca-honda); color: var(--sobre-marca); padding-block: var(--paso-respiro);"
>
  <div class="mx-auto max-w-[var(--container-corto)]">
    <p class="etiqueta" style="color: var(--senal-banda);">{s.contactoTitulo}</p>
    <p class="prosa mt-6" style="color: var(--sobre-marca);">{s.contactoEntrada}</p>
    <p class="mt-4 text-[0.9375rem]" style="color: color-mix(in srgb, var(--sobre-marca) 75%, transparent);">
      {s.contactoAmbito}
    </p>

    <a
      href="https://wa.me/51948860381"
      target="_blank"
      rel="noopener noreferrer"
      class="etiqueta mt-10 inline-flex h-14 items-center gap-2 px-7"
      style="background: var(--color-senal-claro); color: var(--color-tinta-claro);"
    >
      {s.contactoWhatsapp} {s.contactoTelefono}
      <Flecha />
    </a>

    <p
      class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.9375rem]"
      style="color: color-mix(in srgb, var(--sobre-marca) 75%, transparent);"
    >
      <a href="tel:+51948860381" style="color: inherit;" class="hover:underline">
        {s.contactoTelefono}
      </a>
      <a href="mailto:skaan.dmv@gmail.com" style="color: inherit;" class="hover:underline">
        skaan.dmv@gmail.com
      </a>
      <span>{s.contactoUbicacion}</span>
    </p>
  </div>
</section>
