---
import TarjetaProducto from './TarjetaProducto.astro';
import { propios, paraClientes, productos, sectores } from '../data/productos';
import { s } from '../textos';

const enProduccion = productos.filter((p) => p.url).length;

/*
  Las metricas cuentan lo resuelto, no la clientela. Contar clientes con la
  suscripcion recien arrancada juega en contra: la cifra honesta seria pequena
  y la pagina la pondria en grande. Sistemas vivos y sectores distintos son
  igual de ciertos, se calculan solos y dicen lo que un comprador quiere saber.
*/
const metricas = [
  { cifra: String(enProduccion), texto: s.metricaProductos },
  { cifra: String(sectores), texto: s.metricaSectores },
  { cifra: '500 000+', texto: s.metricaRegistros },
];

const resuelvo = [
  { titulo: s.r1Titulo, texto: s.r1Texto },
  { titulo: s.r2Titulo, texto: s.r2Texto },
  { titulo: s.r3Titulo, texto: s.r3Texto },
];

const servicios = [
  { titulo: s.sv1Titulo, texto: s.sv1Texto },
  { titulo: s.sv2Titulo, texto: s.sv2Texto },
  { titulo: s.sv3Titulo, texto: s.sv3Texto },
  { titulo: s.sv4Titulo, texto: s.sv4Texto },
];
---

<!-- Hero -->
<section class="mx-auto max-w-5xl px-6 pb-16 pt-20 sm:pt-28">
  <h1 class="max-w-3xl text-4xl font-bold leading-[1.1] sm:text-5xl">
    {s.heroTitulo}
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed" style="color: var(--texto-suave);">
    {s.heroEntrada}
  </p>
  <p class="mt-3 max-w-2xl text-sm" style="color: var(--acento);">{s.heroPrueba}</p>

  <dl class="mt-12 grid gap-8 sm:grid-cols-3">
    {
      metricas.map((m) => (
        <div class="border-l-2 pl-4" style="border-color: var(--acento);">
          <dt class="text-3xl font-bold tabular-nums">{m.cifra}</dt>
          <dd class="mt-1 text-sm" style="color: var(--texto-suave);">
            {m.texto}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<!--
  Orden deliberado: primero el problema, luego lo que se puede contratar, luego
  la prueba de que ya se hizo, y al final el catalogo. Antes la pagina ensenaba
  el catalogo a alguien que todavia no habia reconocido su problema.
-->

<!-- Que resuelvo -->
<section
  id="resuelvo"
  class="scroll-mt-20 border-t"
  style="border-color: var(--borde); background: var(--fondo-hondo);"
>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold sm:text-3xl">{s.resuelvoTitulo}</h2>
    <p class="mt-3 max-w-2xl" style="color: var(--texto-suave);">{s.resuelvoEntrada}</p>

    <div class="mt-12 space-y-12">
      {
        resuelvo.map((r, i) => (
          <div class="grid gap-4 sm:grid-cols-[3rem_1fr]">
            <span class="text-3xl font-bold tabular-nums" style="color: var(--acento); opacity: 0.5;">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-xl font-semibold">{r.titulo}</h3>
              <p class="mt-3 max-w-2xl leading-relaxed" style="color: var(--texto-suave);">
                {r.texto}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Por que contratarme -->
<section id="servicios" class="scroll-mt-20 border-t" style="border-color: var(--borde);">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold sm:text-3xl">{s.serviciosTitulo}</h2>
    <p class="mt-3 max-w-2xl" style="color: var(--texto-suave);">{s.serviciosEntrada}</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        servicios.map((sv) => (
          <div
            class="rounded-xl border p-6"
            style="border-color: var(--borde); background: var(--fondo-hondo);"
          >
            <h3 class="text-lg font-semibold">{sv.titulo}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--texto-suave);">
              {sv.texto}
            </p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-sm">
      <a href="#contacto" class="font-medium hover:underline" style="color: var(--marca);">
        {s.serviciosLlamada} <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<!-- Casos de exito -->
<section
  id="clientes"
  class="scroll-mt-20 border-t"
  style="border-color: var(--borde); background: var(--fondo-hondo);"
>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold sm:text-3xl">{s.clientesTitulo}</h2>
    <p class="mt-3 max-w-2xl" style="color: var(--texto-suave);">{s.clientesEntrada}</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {paraClientes.map((p) => <TarjetaProducto producto={p} />)}
    </div>
  </div>
</section>

<!-- Proyectos propios -->
<section id="productos" class="scroll-mt-20 border-t" style="border-color: var(--borde);">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold sm:text-3xl">{s.productosTitulo}</h2>
    <p class="mt-3 max-w-2xl" style="color: var(--texto-suave);">{s.productosEntrada}</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {propios.map((p) => <TarjetaProducto producto={p} />)}
    </div>
  </div>
</section>

<!-- Contacto -->
<section
  id="contacto"
  class="scroll-mt-20 border-t"
  style="border-color: var(--borde); background: var(--fondo-hondo);"
>
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-2xl font-bold sm:text-3xl">{s.contactoTitulo}</h2>
    <p class="mt-3 max-w-xl leading-relaxed" style="color: var(--texto-suave);">
      {s.contactoEntrada}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a
        href="mailto:skaan.dmv@gmail.com"
        class="rounded-full px-6 py-3 font-medium"
        style="background: var(--marca); color: var(--fondo);"
      >
        skaan.dmv@gmail.com
      </a>
      <a href="https://linkedin.com/in/danielmoranv" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: var(--texto-suave);">
        LinkedIn
      </a>
      <a href="https://github.com/DanielMoranV" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: var(--texto-suave);">
        GitHub
      </a>
      <span class="text-sm" style="color: var(--texto-suave);">{s.contactoUbicacion}</span>
    </div>
  </div>
</section>
