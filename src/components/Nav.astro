---
import { t, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const s = t[idioma];
const raiz = idioma === 'es' ? '/' : '/en/';
const otra = idioma === 'es' ? '/en/' : '/';

const enlaces = [
  { href: '#productos', texto: s.navProductos },
  { href: '#clientes', texto: s.navClientes },
  { href: '#resuelvo', texto: s.navQueResuelvo },
  { href: '#codigo', texto: s.navCodigo },
];
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur"
  style="border-color: var(--borde); background: color-mix(in srgb, var(--fondo) 88%, transparent);"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3">
    <a href={raiz} class="font-semibold tracking-tight" style="color: var(--marca);">
      Djasoft
    </a>

    <div class="flex items-center gap-x-5 text-sm">
      {
        enlaces.map((e) => (
          <a href={e.href} class="hidden hover:underline sm:inline" style="color: var(--texto-suave);">
            {e.texto}
          </a>
        ))
      }
      <a
        href={otra}
        class="rounded-full border px-3 py-1 text-xs font-medium"
        style="border-color: var(--borde); color: var(--texto-suave);"
      >
        {s.otroIdioma}
      </a>
      <a
        href="#contacto"
        class="rounded-full px-4 py-1.5 text-sm font-medium"
        style="background: var(--marca); color: var(--fondo);"
      >
        {s.navContacto}
      </a>
    </div>
  </nav>
</header>
