---
import { s } from '../textos';

// El orden sigue al de la pagina: problema, oferta, prueba, catalogo.
const enlaces = [
  { href: '#resuelvo', texto: s.navQueResuelvo },
  { href: '#servicios', texto: s.navServicios },
  { href: '#clientes', texto: s.navClientes },
  { href: '#productos', texto: s.navProductos },
];
---

<header class="barra">
  <nav class="mx-auto flex h-14 max-w-[var(--container-ficha)] items-center gap-6 px-6">
    <a href="/" class="rotulo shrink-0 text-[1.0625rem]" style="color: var(--tinta);">Djasoft</a>

    <div class="barra-enlaces etiqueta min-w-0 flex-1">
      {
        enlaces.map((e) => (
          <a href={e.href} class="hover:underline" style="color: var(--tinta2);">
            {e.texto}
          </a>
        ))
      }
    </div>

    <a
      href="#contacto"
      class="etiqueta shrink-0 px-3 py-2"
      style="background: var(--senal); color: var(--color-tinta-claro);"
    >
      {s.navContacto}
    </a>
  </nav>
</header>
