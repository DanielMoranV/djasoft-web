---
import { Image } from 'astro:assets';
import type { Producto } from '../data/productos';

interface Props {
  producto: Producto;
}
const { producto } = Astro.props;
const texto = producto.es;
const nota = producto.nota;
---

<article
  class="flex flex-col rounded-xl border p-6 transition-shadow hover:shadow-lg"
  style="border-color: var(--borde); background: var(--fondo-hondo);"
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      {
        producto.icono && (
          <Image
            src={producto.icono}
            alt=""
            width={48}
            height={48}
            densities={[1, 2]}
            loading="lazy"
            class="h-12 w-12 shrink-0 object-contain"
          />
        )
      }
      {
        producto.iconoSvg && (
          <img
            src={producto.iconoSvg}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            class="h-12 w-12 shrink-0 object-contain"
          />
        )
      }
      <h3 class="text-lg font-semibold">{producto.nombre}</h3>
    </div>
    {
      nota && (
        <span class="shrink-0 rounded-full px-2 py-0.5 text-[0.7rem] font-medium"
              style="background: color-mix(in srgb, var(--acento) 18%, transparent); color: var(--acento);">
          {nota}
        </span>
      )
    }
  </div>

  <p class="mt-3 text-sm font-medium" style="color: var(--acento);">{texto.que}</p>

  {
    producto.cliente && (
      <p class="mt-0.5 text-xs" style="color: var(--texto-suave);">
        {producto.cliente}
      </p>
    )
  }

  <p class="mt-3 flex-1 text-sm leading-relaxed" style="color: var(--texto-suave);">
    {texto.detalle}
  </p>

  <ul class="mt-4 flex flex-wrap gap-1.5">
    {
      producto.stack.map((tec) => (
        <li class="rounded border px-2 py-0.5 text-[0.7rem]"
            style="border-color: var(--borde); color: var(--texto-suave);">
          {tec}
        </li>
      ))
    }
  </ul>

  {
    producto.url && (
      <a
        href={producto.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-1 text-sm font-medium hover:underline"
        style="color: var(--marca);"
      >
        Abrir
        <span aria-hidden="true">→</span>
        <span class="sr-only">{producto.nombre}</span>
      </a>
    )
  }
</article>
