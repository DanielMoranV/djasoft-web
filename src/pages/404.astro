---
import Base from '../layouts/Base.astro';
import Flecha from '../components/Flecha.astro';
import { s } from '../textos';
---

<Base titulo={`${s.error404Titulo} · Djasoft`} descripcion={s.error404Texto} ruta="/404" noindex>
  <section class="px-6" style="padding-block: var(--paso-respiro);">
    <div class="mx-auto max-w-[var(--container-prosa)]">
      <p class="etiqueta" style="color: var(--senal-txt);">404</p>
      <h1 class="mt-3" style="font-size: var(--text-seccion); line-height: 1.02;">
        {s.error404Titulo}
      </h1>
      <p class="prosa mt-6">{s.error404Texto}</p>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
        <a
          href="/"
          class="etiqueta inline-flex items-center gap-2 px-5 py-4"
          style="background: var(--senal); color: var(--color-tinta-claro);"
        >
          {s.error404Inicio}
          <Flecha />
        </a>
        <a
          href="/#productos"
          class="etiqueta inline-flex items-center gap-1.5 self-center underline decoration-[3px] underline-offset-[6px]"
          style="color: var(--tinta); text-decoration-color: var(--senal);"
        >
          {s.error404Proyectos}
        </a>
      </div>

      <p class="mt-12 text-[0.9375rem]" style="color: var(--tinta2);">
        <a href="https://wa.me/51948860381" target="_blank" rel="noopener noreferrer" class="hover:underline">
          WhatsApp: {s.contactoTelefono}
        </a>
      </p>
    </div>
  </section>
</Base>
