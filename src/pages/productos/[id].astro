---
import Base from '../../layouts/Base.astro';
import Flecha from '../../components/Flecha.astro';
import { productos } from '../../data/productos';
import { s } from '../../textos';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { id: p.id }, props: { producto: p } }));
}

const { producto } = Astro.props;
const ruta = `/productos/${producto.id}`;
const canonica = new URL(ruta, Astro.site);
const otros = productos.filter((p) => p.id !== producto.id);

const titulo = `${producto.nombre} — ${producto.es.que} · Djasoft`;
const descripcion = producto.pagina.metaDescripcion;

/**
 * Igual regla que en Base.astro: solo se marca lo que tambien esta visible
 * en la pagina. Producto propio → SoftwareApplication; hecho para un
 * cliente → CreativeWork, porque no es un software que se instale aparte.
 */
const datosProducto =
  producto.modelo === 'propio'
    ? {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: producto.nombre,
        description: producto.es.detalle,
        url: canonica.href,
        ...(producto.url ? { sameAs: producto.url } : {}),
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        author: { '@id': `${new URL('/', Astro.site).href}#djasoft` },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        name: producto.nombre,
        description: producto.es.detalle,
        url: canonica.href,
        ...(producto.url ? { sameAs: producto.url } : {}),
        about: producto.cliente,
        creator: { '@id': `${new URL('/', Astro.site).href}#djasoft` },
      };

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.migaInicio, item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: s.migaProyectos, item: new URL('/#productos', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: producto.nombre, item: canonica.href },
  ],
};
---

<Base titulo={titulo} descripcion={descripcion} ruta={ruta} datosEstructurados={[datosProducto, migas]}>
  <nav aria-label="Migas de pan" class="px-6 pt-8">
    <ol class="etiqueta mx-auto flex max-w-[var(--container-prosa)] flex-wrap gap-x-2" style="color: var(--tinta2);">
      <li><a href="/" class="hover:underline">{s.migaInicio}</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/#productos" class="hover:underline">{s.migaProyectos}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" style="color: var(--tinta);">{producto.nombre}</li>
    </ol>
  </nav>

  <section class="px-6" style="padding-top: 2.5rem; padding-bottom: var(--paso-respiro);">
    <div class="mx-auto max-w-[var(--container-prosa)]">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <p class="etiqueta" style="color: var(--senal-txt);">{producto.es.que}</p>
        {
          producto.nota && (
            <span class="etiqueta" style="color: var(--tinta2);">
              {producto.nota}
            </span>
          )
        }
      </div>

      <h1 class="mt-3" style="font-size: var(--text-seccion); line-height: 1.02;">
        {producto.nombre}
      </h1>

      {
        producto.cliente && (
          <p class="mt-2 text-[0.9375rem]" style="color: var(--tinta2);">
            {producto.cliente}
          </p>
        )
      }

      <p class="prosa mt-6">{producto.es.detalle}</p>

      {
        producto.url && (
          <a
            href={producto.url}
            target="_blank"
            rel="noopener noreferrer"
            class="etiqueta mt-8 inline-flex items-center gap-2 px-5 py-4"
            style="background: var(--senal); color: var(--color-tinta-claro);"
          >
            {s.abrir} {producto.nombre}
            <Flecha />
          </a>
        )
      }

      <div class="mt-16">
        <p class="etiqueta" style="color: var(--senal-txt);">{s.paginaParaQuien}</p>
        <p class="prosa mt-4">{producto.pagina.paraQuien}</p>
      </div>

      <div class="mt-16">
        <p class="etiqueta" style="color: var(--senal-txt);">{s.paginaIncluye}</p>
        <ul class="mt-6 flex flex-col gap-4" style="border-top: 1px solid var(--linea);">
          {
            producto.pagina.caracteristicas.map((c) => (
              <li class="pt-4 text-[1rem] leading-[1.6]" style="border-bottom: 1px solid var(--linea); padding-bottom: 1rem;">
                {c}
              </li>
            ))
          }
        </ul>
      </div>

      <ul class="mt-8 flex flex-wrap gap-2 text-[0.75rem]" style="color: var(--tinta2);">
        {producto.stack.map((tec) => <li class="px-2 py-1" style="border: 1px solid var(--linea);">{tec}</li>)}
      </ul>

      <a href="/#productos" class="etiqueta mt-16 inline-flex items-center gap-1.5 underline decoration-[3px] underline-offset-[6px]" style="color: var(--tinta); text-decoration-color: var(--senal);">
        {s.paginaVolver}
      </a>
    </div>
  </section>

  <section style="background: var(--papel2); border-block: 1px solid var(--linea);">
    <div class="mx-auto max-w-[var(--container-ficha)] px-6 py-10">
      <p class="etiqueta" style="color: var(--tinta2);">{s.paginaOtros}</p>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
        {
          otros.map((p) => (
            <li>
              <a href={`/productos/${p.id}`} class="etiqueta hover:underline" style="color: var(--tinta);">
                {p.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
