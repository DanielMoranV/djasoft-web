---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { s } from '../../textos';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.borrador);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const ruta = `/blog/${post.id}`;
const titulo = `${post.data.titulo} · Djasoft`;

const fechaLarga = new Intl.DateTimeFormat('es-PE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.fecha);

/**
 * Igual regla que en las fichas de producto: solo se marca lo visible en la
 * pagina. `Article` con autor referenciado al Djasoft de la home, mas las
 * migas de pan.
 */
const datosArticulo = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.titulo,
  description: post.data.descripcion,
  datePublished: post.data.fecha.toISOString().slice(0, 10),
  url: new URL(ruta, Astro.site).href,
  author: { '@id': `${new URL('/', Astro.site).href}#djasoft` },
  inLanguage: 'es-PE',
};

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.migaInicio, item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: post.data.titulo, item: new URL(ruta, Astro.site).href },
  ],
};
---

<Base
  titulo={titulo}
  descripcion={post.data.descripcion}
  ruta={ruta}
  datosEstructurados={[datosArticulo, migas]}
>
  <nav aria-label="Migas de pan" class="px-6 pt-8">
    <ol class="etiqueta mx-auto flex max-w-[var(--container-prosa)] flex-wrap gap-x-2" style="color: var(--tinta2);">
      <li><a href="/" class="hover:underline">{s.migaInicio}</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/blog" class="hover:underline">Blog</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" style="color: var(--tinta);">{post.data.titulo}</li>
    </ol>
  </nav>

  <article class="px-6" style="padding-top: 2.5rem; padding-bottom: var(--paso-respiro);">
    <div class="mx-auto max-w-[var(--container-prosa)]">
      <p class="etiqueta" style="color: var(--tinta2);">{fechaLarga}</p>
      <h1 class="mt-3" style="font-size: var(--text-seccion); line-height: 1.02;">
        {post.data.pregunta}
      </h1>

      <div class="articulo mt-10">
        <Content />
      </div>

      <a
        href="/blog"
        class="etiqueta mt-16 inline-flex items-center gap-1.5 underline decoration-[3px] underline-offset-[6px]"
        style="color: var(--tinta); text-decoration-color: var(--senal);"
      >
        Volver al blog
      </a>
    </div>
  </article>
</Base>
