---
import Base from '../layouts/Base.astro';
import Flecha from '../components/Flecha.astro';
import { s } from '../textos';

const ruta = '/software-sullana';
const titulo = 'Software de gestión en Sullana · Djasoft';
const descripcion =
  'Sistemas de gestión para empresas de Sullana e Ignacio Escudero: ERP, facturación ' +
  'electrónica y automatización. Presencial cuando hace falta.';

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.migaInicio, item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Software en Sullana', item: new URL(ruta, Astro.site).href },
  ],
};
---

<Base titulo={titulo} descripcion={descripcion} ruta={ruta} datosEstructurados={[migas]}>
  <nav aria-label="Migas de pan" class="px-6 pt-8">
    <ol class="etiqueta mx-auto flex max-w-[var(--container-prosa)] flex-wrap gap-x-2" style="color: var(--tinta2);">
      <li><a href="/" class="hover:underline">{s.migaInicio}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" style="color: var(--tinta);">Software en Sullana</li>
    </ol>
  </nav>

  <section class="px-6" style="padding-top: 2.5rem; padding-bottom: var(--paso-respiro);">
    <div class="mx-auto max-w-[var(--container-prosa)]">
      <p class="etiqueta" style="color: var(--senal-txt);">Sullana e Ignacio Escudero</p>
      <h1 class="mt-3" style="font-size: var(--text-seccion); line-height: 1.02;">
        Software de gestión en Sullana.
      </h1>

      <p class="prosa mt-6">
        Trabajo desde Ignacio Escudero, en la provincia de Sullana. Si su empresa está aquí, puedo
        sentarme frente al sistema con usted —no todo se resuelve por videollamada, y cuando hay
        que estar delante de la computadora, estoy a quince minutos, no a un vuelo de distancia.
      </p>

      <p class="prosa mt-5">
        No llego con un producto genérico a ver dónde encaja: ERP, planillas, facturación
        electrónica ante SUNAT, comercio electrónico o automatización sobre el sistema que ya usa
        —FoxPro, hojas de cálculo, lo que sea—, sin apagarlo mientras se construye alrededor.
      </p>

      <div class="mt-12 pt-6" style="border-top: 1px solid var(--linea);">
        <p class="etiqueta" style="color: var(--senal-txt);">Un caso en Sullana</p>
        <h2 class="mt-3" style="font-size: var(--text-ficha); line-height: 1.15;">SURGIMED</h2>
        <p class="mt-3 text-[1rem] leading-[1.6]">
          Sitio institucional para Surgical Medical Equipment E.I.R.L., importador de material de
          osteosíntesis y equipamiento quirúrgico en Sullana, con despliegue continuo desde el
          repositorio: cada cambio se publica solo.
        </p>
        <a
          href="/productos/surgimed"
          class="etiqueta mt-4 inline-flex items-center gap-1.5 underline decoration-[3px] underline-offset-[6px]"
          style="color: var(--tinta); text-decoration-color: var(--senal);"
        >
          Ver la ficha de SURGIMED
          <Flecha />
        </a>
      </div>

      <div class="mt-12 pt-6" style="border-top: 1px solid var(--linea);">
        <p class="etiqueta" style="color: var(--senal-txt);">Qué puedo hacer por una empresa en Sullana</p>
        <ul class="mt-6 flex flex-col gap-4">
          <li class="pb-4 text-[1rem] leading-[1.6]" style="border-bottom: 1px solid var(--linea);">
            Poner en marcha AlmaZen, Mozaico o EasyPay con sus datos y su forma de trabajar.
          </li>
          <li class="pb-4 text-[1rem] leading-[1.6]" style="border-bottom: 1px solid var(--linea);">
            Automatizar e integrar el sistema que ya tiene, sin cambiarle la rutina a nadie.
          </li>
          <li class="text-[1rem] leading-[1.6]">
            Consultoría con criterio: qué automatizar primero y qué conviene no tocar todavía.
          </li>
        </ul>
      </div>

      <a
        href="https://wa.me/51948860381"
        target="_blank"
        rel="noopener noreferrer"
        class="etiqueta mt-12 inline-flex h-14 items-center gap-2 px-7"
        style="background: var(--senal); color: var(--color-tinta-claro);"
      >
        {s.contactoWhatsapp} {s.contactoTelefono}
        <Flecha />
      </a>
    </div>
  </section>
</Base>
