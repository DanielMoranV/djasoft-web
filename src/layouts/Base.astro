---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { s, PERFIL_TECNICO } from '../textos';

/**
 * Props opcionales para paginas distintas de la home (fichas de producto,
 * casos). Sin props, el layout se comporta exactamente como antes.
 */
interface Props {
  titulo?: string;
  descripcion?: string;
  ruta?: string;
  /** JSON-LD adicional al de la home (ProfessionalService), uno por objeto. */
  datosEstructurados?: object[];
}
const {
  titulo = s.titulo,
  descripcion = s.descripcion,
  ruta = '/',
  datosEstructurados = [],
} = Astro.props;

const canonica = new URL(ruta, Astro.site);

/**
 * Tarjeta de enlace, generada una vez y commiteada en public/: un PNG que no
 * cambia no justifica una dependencia de build —y menos aqui, donde el pipeline
 * de imagenes de Astro ya fallo en el entorno de Cloudflare.
 *
 * Sin esto, compartir el sitio por WhatsApp o LinkedIn mostraba un rectangulo
 * vacio. En un sitio comercial eso es la primera impresion de cada recomendado.
 */
const tarjeta = new URL('/og.png', Astro.site);

/**
 * Datos estructurados. Es lo que leen Google y los sistemas de IA cuando
 * necesitan responder "quien hace software de gestion en Sullana": el texto lo
 * interpretan, esto lo entienden.
 *
 * REGLA: aqui solo va lo que tambien esta VISIBLE en la pagina. Marcar datos
 * que el visitante no ve es justo lo que Google penaliza, asi que el ambito
 * geografico vive tambien en el bloque de contacto, en texto normal.
 */
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${canonica.href}#djasoft`,
  name: 'Djasoft',
  alternateName: 'Djasoft — Daniel Morán Vílchez',
  url: canonica.href,
  image: tarjeta.href,
  description: s.descripcion,
  email: 'mailto:skaan.dmv@gmail.com',
  /*
    El telefono debe coincidir DIGITO A DIGITO con el de la ficha de Google
    (DaniTec, Ignacio Escudero): Google contrasta ficha y web, y un numero que
    no cuadra resta en vez de sumar.
  */
  telephone: '+51948860381',
  inLanguage: 'es-PE',
  founder: {
    '@type': 'Person',
    name: 'Daniel Morán Vílchez',
    url: PERFIL_TECNICO,
    jobTitle: 'Desarrollador full stack e ingeniero de datos',
  },
  /*
    La localidad es Ignacio Escudero, distrito de la provincia de Sullana. Es
    lo que dice la ficha de Google, y ficha y sitio tienen que decir lo mismo.
    Sullana y Piura entran abajo, en areaServed, que es su sitio correcto.
  */
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ignacio Escudero',
    addressRegion: 'Piura',
    addressCountry: 'PE',
  },
  areaServed: [
    { '@type': 'City', name: 'Piura' },
    { '@type': 'City', name: 'Sullana' },
    { '@type': 'AdministrativeArea', name: 'Ignacio Escudero' },
    { '@type': 'Country', name: 'Perú' },
  ],
  knowsAbout: [
    'ERP', 'Facturación electrónica SUNAT', 'Planillas', 'Punto de venta',
    'Migración de sistemas FoxPro', 'Automatización de procesos',
    'Integración de sistemas', 'Inteligencia artificial aplicada',
    'SIAGIE', 'SUSALUD', 'Comercio electrónico',
  ],
  sameAs: [
    'https://github.com/DanielMoranV',
    'https://linkedin.com/in/danielmoranv',
    PERFIL_TECNICO,
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.serviciosTitulo,
    itemListElement: [
      { titulo: s.sv1Titulo, texto: s.sv1Texto },
      { titulo: s.sv2Titulo, texto: s.sv2Texto },
      { titulo: s.sv3Titulo, texto: s.sv3Texto },
      { titulo: s.sv4Titulo, texto: s.sv4Texto },
    ].map((sv) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: sv.titulo, description: sv.texto },
    })),
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <!--
      Antes que cualquier estilo o marcado: la preferencia guardada se escribe
      en la raiz antes del primer pintado. Sin esto, quien haya elegido claro
      ve un destello oscuro en cada carga, y una marca que parpadea se ve peor
      que una sin conmutador.
    -->
    <script is:inline>
      const t = localStorage.getItem('tema');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    </script>

    <!-- Precargadas: son dos peticiones y 74 KB, y sin esto el titular grande
         parpadea al cambiar de la fuente de respaldo a Archivo. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/literata-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Djasoft" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={tarjeta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={s.tarjetaAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={tarjeta} />

    <script type="application/ld+json" set:html={JSON.stringify(negocio)} is:inline />
    {
      datosEstructurados.map((d) => (
        <script type="application/ld+json" set:html={JSON.stringify(d)} is:inline />
      ))
    }

    <meta name="author" content="Daniel Morán Vílchez" />
    <meta name="theme-color" content="#f7f2e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101820" media="(prefers-color-scheme: dark)" />
  </head>

  <body>
    <a
      href="#contenido"
      class="etiqueta sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:px-4 focus:py-3"
      style="background: var(--senal); color: var(--color-tinta-claro);"
    >
      Saltar al contenido
    </a>

    <Nav />
    <main id="contenido"><slot /></main>

    <footer style="border-top: 1px solid var(--linea);">
      <div
        class="mx-auto flex max-w-[var(--container-ficha)] flex-col gap-4 px-6 py-10 text-[0.8125rem] sm:flex-row sm:items-center sm:justify-between"
        style="color: var(--tinta2);"
      >
        <div class="flex flex-wrap items-center gap-4">
          <p class="rotulo text-[1.0625rem]" style="color: var(--tinta);">Djasoft</p>
          <!-- El segundo grupo de tema: el del menu solo existe en movil, y en
               escritorio el panel esta oculto. El script sincroniza los dos. -->
          <fieldset class="tema">
            <legend class="sr-only">{s.temaLeyenda}</legend>
            <button type="button" data-tema="light" aria-pressed="false">{s.temaClaro}</button>
            <button type="button" data-tema="dark" aria-pressed="false">{s.temaOscuro}</button>
            <button type="button" data-tema="system" aria-pressed="true">{s.temaSistema}</button>
          </fieldset>
        </div>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          <a class="hover:underline" href={PERFIL_TECNICO} target="_blank" rel="noopener noreferrer">
            {s.piePerfil}
          </a>
          <a class="hover:underline" href="https://github.com/DanielMoranV" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="hover:underline" href="https://linkedin.com/in/danielmoranv" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </div>
    </footer>

    <!--
      El conmutador. Tres estados reales; «sistema» es la AUSENCIA de atributo
      en la raiz y de clave en localStorage, asi que sigue al sistema en vivo
      sin escuchar nada. Elegir claro gana sobre un sistema en oscuro gracias
      al :not([data-theme='light']) del CSS.

      Hay dos grupos de botones —el del menu movil y el del pie— porque el
      panel del menu esta oculto en escritorio. Se sincronizan los dos.

      Es el unico JavaScript del sitio.
    -->
    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        const grupos = document.querySelectorAll('.tema');
        if (!grupos.length) return;
        const metas = document.querySelectorAll('meta[name="theme-color"]');

        const aplicar = (v) => {
          if (v === 'system') {
            raiz.removeAttribute('data-theme');
            localStorage.removeItem('tema');
          } else {
            raiz.dataset.theme = v;
            localStorage.setItem('tema', v);
          }
          const oscuro =
            v === 'dark' ||
            (v === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          metas.forEach((m) => {
            m.removeAttribute('media');
            m.content = oscuro ? '#101820' : '#f7f2e9';
          });
          grupos.forEach((g) =>
            g
              .querySelectorAll('button')
              .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tema === v)))
          );
        };

        aplicar(localStorage.getItem('tema') ?? 'system');
        grupos.forEach((g) =>
          g.addEventListener('click', (e) => {
            const b = e.target.closest('button[data-tema]');
            if (b) aplicar(b.dataset.tema);
          })
        );
      })();
    </script>
  </body>
</html>
