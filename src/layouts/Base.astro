---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { s, PERFIL_TECNICO } from '../textos';

const canonica = new URL('/', Astro.site);

/**
 * Tarjeta de enlace, generada una vez y commiteada en public/: un PNG que no
 * cambia no justifica una dependencia de build —y menos aqui, donde el pipeline
 * de imagenes de Astro ya fallo en el entorno de Cloudflare.
 *
 * Sin esto, compartir el sitio por WhatsApp o LinkedIn mostraba un rectangulo
 * vacio. En un sitio comercial eso es la primera impresion de cada recomendado.
 */
const tarjeta = new URL('/og.png', Astro.site);

/**
 * Datos estructurados. Es lo que leen Google y los sistemas de IA cuando
 * necesitan responder "quien hace software de gestion en Sullana": el texto lo
 * interpretan, esto lo entienden.
 *
 * REGLA: aqui solo va lo que tambien esta VISIBLE en la pagina. Marcar datos
 * que el visitante no ve es justo lo que Google penaliza, asi que el ambito
 * geografico vive tambien en el bloque de contacto, en texto normal.
 */
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${canonica.href}#djasoft`,
  name: 'Djasoft',
  alternateName: 'Djasoft — Daniel Morán Vílchez',
  url: canonica.href,
  image: tarjeta.href,
  description: s.descripcion,
  email: 'mailto:skaan.dmv@gmail.com',
  inLanguage: 'es-PE',
  founder: {
    '@type': 'Person',
    name: 'Daniel Morán Vílchez',
    url: PERFIL_TECNICO,
    jobTitle: 'Desarrollador full stack e ingeniero de datos',
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Piura',
    addressCountry: 'PE',
  },
  areaServed: [
    { '@type': 'City', name: 'Piura' },
    { '@type': 'City', name: 'Sullana' },
    { '@type': 'AdministrativeArea', name: 'Ignacio Escudero' },
    { '@type': 'Country', name: 'Perú' },
  ],
  knowsAbout: [
    'ERP', 'Facturación electrónica SUNAT', 'Planillas', 'Punto de venta',
    'Migración de sistemas FoxPro', 'Automatización de procesos',
    'Integración de sistemas', 'Inteligencia artificial aplicada',
    'SIAGIE', 'SUSALUD', 'Comercio electrónico',
  ],
  sameAs: [
    'https://github.com/DanielMoranV',
    'https://linkedin.com/in/danielmoranv',
    PERFIL_TECNICO,
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.serviciosTitulo,
    itemListElement: [
      { titulo: s.sv1Titulo, texto: s.sv1Texto },
      { titulo: s.sv2Titulo, texto: s.sv2Texto },
      { titulo: s.sv3Titulo, texto: s.sv3Texto },
      { titulo: s.sv4Titulo, texto: s.sv4Texto },
    ].map((sv) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: sv.titulo, description: sv.texto },
    })),
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{s.titulo}</title>
    <meta name="description" content={s.descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Djasoft" />
    <meta property="og:title" content={s.titulo} />
    <meta property="og:description" content={s.descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={tarjeta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={s.tarjetaAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={tarjeta} />

    <script type="application/ld+json" set:html={JSON.stringify(negocio)} is:inline />

    <meta name="author" content="Daniel Morán Vílchez" />
    <meta name="theme-color" content="#1b4965" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1420" media="(prefers-color-scheme: dark)" />
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:px-4 focus:py-2"
      style="background: var(--marca); color: var(--fondo);"
    >
      Saltar al contenido
    </a>

    <Nav />
    <main id="contenido"><slot /></main>

    <footer style="border-color: var(--borde);" class="border-t">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-10 text-sm sm:flex-row sm:items-center sm:justify-between"
        style="color: var(--texto-suave);"
      >
        <p>© {new Date().getFullYear()} {s.pieDerechos}</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          <a class="hover:underline" href={PERFIL_TECNICO} target="_blank" rel="noopener noreferrer">
            {s.piePerfil}
          </a>
          <a class="hover:underline" href="https://github.com/DanielMoranV" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="hover:underline" href="https://linkedin.com/in/danielmoranv" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
